<Window x:Class="Portafotos.Windows.SnipperOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snipper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    <Grid x:Name="RootGrid">
        <!-- Imagen estatica congelada de la pantalla -->
        <Image x:Name="ScreenImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Capa de oscurecimiento con hueco recortado para la seleccion -->
        <Path x:Name="DarkMaskPath" Fill="#80000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullMaskGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="SelectionMaskGeometry" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Borde vibrante del rectangulo de seleccion -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#3B82F6"
                BorderThickness="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed" />

        <!-- Etiqueta de dimensiones (anchura x altura) -->
        <Border x:Name="DimensionBadge"
                Background="#D91E293B"
                CornerRadius="4"
                Padding="6,3"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <TextBlock x:Name="DimensionText"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Text="0 × 0 px" />
        </Border>

        <!-- Indicador de ayuda en la esquina superior -->
        <Border Background="#BF0F172A"
                CornerRadius="8"
                Padding="14,7"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0">
            <TextBlock Text="Arrastra para seleccionar área • Espacio/Tab para ver la cuerda • Esc para cancelar"
                       Foreground="#F8FAFC"
                       FontSize="13"
                       FontWeight="Medium" />
        </Border>
    </Grid>
</Window>
