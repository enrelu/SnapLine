<Window x:Class="SnapLine.Windows.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Captura - SnapLine"
        Width="1050"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Estilo de botones de herramienta -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de botones de accion -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo boton primario -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="BorderBrush" Value="#059669" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#059669" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR DE HERRAMIENTAS -->
        <Border Grid.Row="0"
                Background="#1E293B"
                BorderBrush="#334155"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- HERRAMIENTAS DE DIBUJO -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Herramienta:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                    
                    <RadioButton x:Name="RectToolRadio"
                                 Style="{StaticResource ToolButtonStyle}"
                                 GroupName="Tools"
                                 IsChecked="True"
                                 ToolTip="Recuadro">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="12" Stroke="#F8FAFC" StrokeThickness="1.5" Margin="0,0,5,0" />
                            <TextBlock Text="Recuadro" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CircleToolRadio"
                                 Style="{StaticResource ToolButtonStyle}"
                                 GroupName="Tools"
                                 ToolTip="Círculo / Elipse">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="14" Height="14" Stroke="#F8FAFC" StrokeThickness="1.5" Margin="0,0,5,0" />
                            <TextBlock Text="Círculo" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ArrowToolRadio"
                                 Style="{StaticResource ToolButtonStyle}"
                                 GroupName="Tools"
                                 ToolTip="Flecha">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,5 L 10,5 M 6,1 L 10,5 L 6,9" Stroke="#F8FAFC" StrokeThickness="1.5" Margin="0,0,5,0" />
                            <TextBlock Text="Flecha" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TextToolRadio"
                                 Style="{StaticResource ToolButtonStyle}"
                                 GroupName="Tools"
                                 ToolTip="Texto">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="T" FontWeight="Bold" Margin="0,0,5,0" />
                            <TextBlock Text="Texto" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Separador -->
                    <Rectangle Width="1" Height="24" Fill="#334155" Margin="10,0" />

                    <!-- PALETA DE COLORES -->
                    <TextBlock Text="Color:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" x:Name="ColorPalettePanel" VerticalAlignment="Center">
                        <!-- Botones de colores -->
                    </StackPanel>

                    <!-- Separador -->
                    <Rectangle Width="1" Height="24" Fill="#334155" Margin="10,0" />

                    <!-- GROSOR -->
                    <TextBlock Text="Grosor:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                    <ComboBox x:Name="StrokeThicknessCombo"
                              Width="70"
                              Background="#0F172A"
                              Foreground="#FFFFFF"
                              SelectionChanged="StrokeThicknessCombo_SelectionChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="2 px" IsSelected="True" Tag="2" />
                        <ComboBoxItem Content="4 px" Tag="4" />
                        <ComboBoxItem Content="8 px" Tag="8" />
                    </ComboBox>
                </StackPanel>

                <!-- BOTONES DE ACCION A LA DERECHA -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="UndoButton_Click"
                            ToolTip="Deshacer (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2,7 L 6,3 M 2,7 L 6,11 M 2,7 L 11,7 A 4,4 0 0,1 15,11" Stroke="#F8FAFC" StrokeThickness="1.5" Margin="0,0,6,0" />
                            <TextBlock Text="Deshacer" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CopyButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="CopyButton_Click"
                            ToolTip="Copiar al portapapeles">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4,4 L 10,4 L 10,14 L 4,14 Z M 7,1 L 13,1 L 13,11 L 10,11" Stroke="#F8FAFC" StrokeThickness="1.2" Margin="0,0,6,0" />
                            <TextBlock Text="Copiar" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveButton_Click"
                            ToolTip="Guardar cambios">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,8 L 6,11 L 13,4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,6,0" />
                            <TextBlock Text="Guardar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIENZO DE LA CAPTURA Y ANOTACIONES -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#090D16">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <!-- Lienzo que contiene la imagen de fondo y las figuras dibujadas -->
                <Canvas x:Name="DrawingCanvas"
                        Background="Transparent"
                        MouseDown="DrawingCanvas_MouseDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseUp="DrawingCanvas_MouseUp"
                        Cursor="Cross">
                    <Image x:Name="ScreenshotImage" Stretch="None" Canvas.Left="0" Canvas.Top="0" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- BARRA INFERIOR DE ESTADO -->
        <Border Grid.Row="2"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="DimensionsLabel"
                           Text="Dimensiones: 0 × 0 px"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ToastLabel"
                           Text=""
                           Foreground="#10B981"
                           FontWeight="SemiBold"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="Presiona Esc para cerrar"
                           Foreground="#64748B"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
